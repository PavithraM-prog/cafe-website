# Database Connection URL (PostgreSQL in Docker container)
DATABASE_URL="postgresql://postgres:password@localhost:5432/cafe_db?schema=public"

# Node Environment
NODE_ENV="development"

# Server Port
PORT=3000

# Authentication Secrets
JWT_SECRET="your_jwt_secret_here"
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Sentry DSN (Application Monitoring)
NEXT_PUBLIC_SENTRY_DSN="your_sentry_dsn_here"
